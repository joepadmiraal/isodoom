# IsoDoom code style (Q3, SPEC §12). The target is the Godot C# style guide
# (https://docs.godotengine.org/en/stable/tutorials/scripting/c_sharp/c_sharp_style_guide.html),
# which builds on Microsoft's .NET coding conventions
# (https://learn.microsoft.com/en-us/dotnet/csharp/fundamentals/coding-style/coding-conventions);
# where the two disagree, Godot's guide wins. Ported vanilla code keeps vanilla
# names (CLAUDE.md), but the formatting rules apply to it too.
#
# `dotnet format IsoDoom.sln` fixes the code; CI checks it with
# `dotnet format IsoDoom.sln --verify-no-changes --no-restore --severity warn`.

root = true

# Files and whitespace (Godot: UTF-8 without BOM, LF, one final newline).
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# MSBuild and data files: two spaces, as the SDK templates write them.
[*.{csproj,props,targets,json,yml,yaml}]
indent_size = 2

# Godot's guide ends every file with a newline "except for csproj files",
# which Godot itself writes without one; ours have one. Enforce neither.
[*.csproj]
insert_final_newline = unset

# Solution files: as Visual Studio and `dotnet sln` write them.
[*.sln]
end_of_line = crlf
indent_style = tab

# GDScript and shaders: tabs (Godot's GDScript and shading style guides).
[*.{gd,gdshader,gdshaderinc}]
indent_style = tab
max_line_length = 100

# Godot's own resource formats: written by the editor, no indentation.
[*.{tscn,tres,godot,cfg,import}]
indent_style = unset
indent_size = unset

# A unified diff's context lines may end in spaces; trimming them breaks it.
[*.patch]
trim_trailing_whitespace = false
insert_final_newline = unset

# Markdown: nested lists indent by their marker's width.
[*.md]
indent_size = unset

# Generated or third-party code: no style analysis. (doom_20230531/ is a
# downloaded archive of the original game, gitignored; tools/VanillaRef and
# tools/OplRef fetch their third-party sources into ~/.cache, so everything
# they track is ours.)
[{.godot,export,doom_20230531,bin,obj}/**]
generated_code = true

[**/{bin,obj}/**]
generated_code = true

[*.cs]
# Godot: consider breaking lines longer than 100 characters. Roslyn can't
# enforce it; editors show the ruler.
max_line_length = 100

#### Layout (IDE0055) ####
# Allman braces; else, catch and finally on their own lines.
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents_when_block = true

# Godot: spaces around binary operators, after control flow keywords and
# commas, none after a cast.
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_parentheses = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_around_binary_operators = before_and_after
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_after_comma = true
csharp_space_before_comma = false
csharp_space_after_dot = false
csharp_space_before_dot = false
csharp_space_after_semicolon_in_for_statement = true
csharp_space_before_semicolon_in_for_statement = false
csharp_space_around_declaration_statements = false
csharp_space_before_open_square_brackets = false
csharp_space_between_empty_square_brackets = false
csharp_space_between_square_brackets = false

csharp_preserve_single_line_statements = true
csharp_preserve_single_line_blocks = true

#### Usings and namespaces ####
# System first, outside the namespace (.NET conventions); file-scoped
# namespaces. Godot: remove unused usings.
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0065.severity = warning
dotnet_diagnostic.IDE0161.severity = warning

#### var (IDE0007, IDE0008) ####
# Godot: `var` only when the type is evident from the right side (`new`, a
# cast, a literal); explicit types for numbers.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

#### Language keywords, modifiers, `this.` ####
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
# Godot: explicit access modifiers, in its order (public, protected, private,
# internal, virtual, override, abstract, new, static, readonly); the others
# where .NET's default puts them.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
csharp_preferred_modifier_order = public, protected, private, internal, file, virtual, sealed, override, abstract, new, static, extern, readonly, unsafe, required, volatile, async:suggestion

# Expression-bodied members, pattern matching, null checks and the other
# expression-level preferences keep the IDE defaults, but for:
# - Primary constructors (IDE0290): their parameters are mutable captures,
#   not the readonly fields they would replace, and the vanilla structs keep
#   their C layout. Constructors stay as written.
csharp_style_prefer_primary_constructors = false:suggestion

#### Naming (IDE1006) ####
# Godot: PascalCase types, methods, properties, events, constants and
# non-private fields; _camelCase private fields (static ones too: Godot's
# guide has no s_ prefix); camelCase locals and parameters; I-prefixed
# interfaces. .NET's conventions add PascalCase local constants and local
# functions. Enforced (warning) everywhere but in ported code, which keeps
# vanilla names (mobj_t, P_Random, mobjinfo, mobj_t.momx): see the ported
# files' section below (Q4, SPEC §12).
dotnet_diagnostic.IDE1006.severity = warning

dotnet_naming_rule.interfaces_begin_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_begin_with_i.style = i_pascal_case
dotnet_naming_rule.interfaces_begin_with_i.severity = warning

dotnet_naming_rule.types_are_pascal_case.symbols = types
dotnet_naming_rule.types_are_pascal_case.style = pascal_case
dotnet_naming_rule.types_are_pascal_case.severity = warning

dotnet_naming_rule.constants_are_pascal_case.symbols = constants
dotnet_naming_rule.constants_are_pascal_case.style = pascal_case
dotnet_naming_rule.constants_are_pascal_case.severity = warning

dotnet_naming_rule.private_fields_are_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscore_camel_case.style = underscore_camel_case
dotnet_naming_rule.private_fields_are_underscore_camel_case.severity = warning

dotnet_naming_rule.members_are_pascal_case.symbols = members
dotnet_naming_rule.members_are_pascal_case.style = pascal_case
dotnet_naming_rule.members_are_pascal_case.severity = warning

dotnet_naming_rule.locals_are_camel_case.symbols = locals_and_parameters
dotnet_naming_rule.locals_are_camel_case.style = camel_case
dotnet_naming_rule.locals_are_camel_case.severity = warning

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate, namespace
dotnet_naming_symbols.types.applicable_accessibilities = *

dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_symbols.members.applicable_kinds = method, property, event, field, local_function
dotnet_naming_symbols.members.applicable_accessibilities = *

dotnet_naming_symbols.locals_and_parameters.applicable_kinds = local, parameter
dotnet_naming_symbols.locals_and_parameters.applicable_accessibilities = *

dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

dotnet_naming_style.i_pascal_case.capitalization = pascal_case
dotnet_naming_style.i_pascal_case.required_prefix = I

#### Code analysis (Q5, SPEC §12) ####
# Directory.Build.props runs the SDK's analyzers in the build:
# `AnalysisLevel` latest, `AnalysisMode` Recommended (its rules at warning,
# so errors with TreatWarningsAsErrors) and `EnforceCodeStyleInBuild` (the
# IDE rules at warning above fail the build too, not only CI's format step).
# Each rule turned down below says why; the ported files' sections at the end
# turn down the rules that would rewrite or rename vanilla code.

# Missing XML doc comments (CS1591): neither style guide asks for them on
# every public member. GenerateDocumentationFile is on because the build's
# IDE0005 needs it; the doc comments that exist are still checked (bad
# `cref`s, CS0419/CS1574, and the other CS15xx/CS17xx stay warnings).
dotnet_diagnostic.CS1591.severity = none

# Cache a CompositeFormat (CA1863): every flagged format runs once per menu
# message, check or test; a static field per format would add noise for no
# measurable gain.
dotnet_diagnostic.CA1863.severity = none

# Dead stores (IDE0059) and unused parameters (IDE0060): fixed in our code
# and enforced; ported code keeps vanilla's statements and parameter lists
# (its sections below). An override or a handler whose signature is given
# discards a parameter with `_`.
dotnet_diagnostic.IDE0059.severity = warning
dotnet_diagnostic.IDE0060.severity = warning

# Left at the IDE default, suggestion (shown in editors, not enforced): switch
# expressions (IDE0066), tuple swaps (IDE0180), deconstruction (IDE0042) and
# foreach's explicit casts (IDE0220) are preferences whose fixes Q3 found
# unsafe or unreadable here (60-case `or` chains, locals named `Left`, a broken
# build over a Godot array); null propagation (IDE0031) too, but for ported
# code (none there).

# Namespaces match folders (IDE0130), but the Godot project's root is the
# repository root while its namespaces (IsoDoom.Game, IsoDoom.Render, ...)
# start at src/; the libraries' projects sit in their folders and match.
[src/{Assets,Audio,Game,Render}/**.cs]
dotnet_diagnostic.IDE0130.severity = none

# The purity scanner's fixtures are its test input: each construct (a lambda,
# `new()`, the namespace, a public float field, an instance member that could
# be static) is there on purpose, so no style or code-analysis rule rewrites
# or flags them (Q5). Whitespace formatting still applies.
[tests/IsoDoom.Tests/Purity/ScannerFixtures.cs]
dotnet_analyzer_diagnostic.category-Style.severity = none
dotnet_diagnostic.CA1051.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.IDE0130.severity = none

# Ported code (Q4, SPEC §12): files that port vanilla or Chocolate Doom code
# under its own names keep them, so diffs against linuxdoom and Chocolate
# Doom stay easy; the naming rules skip them whole, our additions in them
# included (they follow the vanilla style around them). All of Sim is ported
# but its files that hold only our own code, which the next section enforces
# again. A file that ports logic under .NET names (Level, Blockmap, MusSong,
# LevelScene, ...) is not listed; a non-ported file that keeps a few vanilla
# names marks each with [SuppressMessage("Style", "IDE1006")] and its source.
# The code-analysis rules that would rename or reshape vanilla code (Q5):
# underscores in names (CA1707), the ported structs' public fields (CA1051:
# mobj_t.momx), members that could be static (CA1822: vanilla's functions
# are World members standing in for its globals), names differing only in
# case (CA1708: player_t.viewheight and VIEWHEIGHT), and the IDE rules Q3
# left unapplied (vanilla's dead stores, parameter lists, switch statements,
# swaps and null checks).
[src/Sim/**.cs]
dotnet_diagnostic.IDE1006.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1051.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1708.severity = none
dotnet_diagnostic.IDE0059.severity = none
dotnet_diagnostic.IDE0060.severity = none
dotnet_diagnostic.IDE0066.severity = none
dotnet_diagnostic.IDE0180.severity = none
dotnet_diagnostic.IDE0031.severity = none

[src/Sim/{Tweaks,SimInfo,World.AimAssist,World.Checksum,World.Unported}.cs]
dotnet_diagnostic.IDE1006.severity = warning
dotnet_diagnostic.CA1707.severity = warning
dotnet_diagnostic.CA1051.severity = warning
dotnet_diagnostic.CA1822.severity = warning
dotnet_diagnostic.CA1708.severity = warning
dotnet_diagnostic.IDE0059.severity = warning
dotnet_diagnostic.IDE0060.severity = warning
dotnet_diagnostic.IDE0031.severity = suggestion
dotnet_diagnostic.IDE0066.severity = suggestion
dotnet_diagnostic.IDE0180.severity = suggestion

[src/Audio/{MidiFile,Mus2Mid,Opl3,OplMusic,SSound}.cs]
dotnet_diagnostic.IDE1006.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1051.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1708.severity = none
dotnet_diagnostic.IDE0059.severity = none
dotnet_diagnostic.IDE0060.severity = none
dotnet_diagnostic.IDE0066.severity = none
dotnet_diagnostic.IDE0180.severity = none
dotnet_diagnostic.IDE0031.severity = none

[src/Game/{FFinale,FFinale.Texts,FWipe,GameFlow,HuStuff,MMenu,StStuff,WiStuff}.cs]
dotnet_diagnostic.IDE1006.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1051.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1708.severity = none
dotnet_diagnostic.IDE0059.severity = none
dotnet_diagnostic.IDE0060.severity = none
dotnet_diagnostic.IDE0066.severity = none
dotnet_diagnostic.IDE0180.severity = none
dotnet_diagnostic.IDE0031.severity = none

# Wad and Map keep vanilla's names for the lump, BSP and renderer functions and
# flags they port under .NET types (W_CheckNumForName, R_PointInSubsector,
# ML_BLOCKING, NF_SUBSECTOR, about 65): CA1707 would flag each, while IDE1006
# still checks the rest of their names. Our own files elsewhere that keep a
# vanilla name mark it with [SuppressMessage("Naming", "CA1707")].
[src/{Wad,Map}/**.cs]
dotnet_diagnostic.CA1707.severity = none

# Tests: their names are sentences, some naming the vanilla function they
# test (P_Random_wraps_after_256), and their constant arrays are expected
# values passed once (CA1861 is about hot paths).
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
