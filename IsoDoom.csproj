<Project Sdk="Godot.NET.Sdk/4.7.2">
  <!-- Godot (presentation) project. Wad, Map and Sim are plain .NET class
       libraries with no Godot reference (SPEC §4, §12); this project
       references them and holds Assets, Render, Game and Audio. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>IsoDoom</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- The SDK globs every .cs file below the project root; the plain
         libraries, tests and tools are compiled by their own projects. -->
    <Compile Remove="src/Wad/**;src/Map/**;src/Sim/**;tests/**;tools/**" />
    <None Remove="src/Wad/**;src/Map/**;src/Sim/**;tests/**;tools/**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="src/Wad/IsoDoom.Wad.csproj" />
    <ProjectReference Include="src/Map/IsoDoom.Map.csproj" />
    <ProjectReference Include="src/Sim/IsoDoom.Sim.csproj" />
  </ItemGroup>
</Project>
