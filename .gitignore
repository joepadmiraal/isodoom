# Game data (never commit WADs). Only the .gdignore markers (which stop
# Godot importing these folders) are tracked.
wads/*
!wads/.gdignore
*.wad
*.WAD

# Screenshots of the game (WAD-derived: never commit them). Its .gdignore
# stops Godot importing them.
screenshots/

# Godot
.godot/
export/
*.translation

# .NET
bin/
obj/
*.user
.vs/
TestResults/

# Claude Code: agent worktrees and personal settings (a shared
# .claude/settings.json may be committed)
.claude/worktrees/
.claude/settings.local.json

# local deploy/test scripts
deploy/