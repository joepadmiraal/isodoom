<Project Sdk="Microsoft.NET.Sdk">
  <!-- Writes a small synthetic IWAD (original, generated content; no id
       Software data) for running the WAD viewer check in CI (T1.6b):
       see Program.cs for the command line. Plain .NET, no
       Godot reference; never ships with the game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
    <RootNamespace>IsoDoom.Tools.SyntheticIwad</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Wad/IsoDoom.Wad.csproj" />
  </ItemGroup>
</Project>
