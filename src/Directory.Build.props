<Project>
  <!-- Shared settings for the plain .NET class libraries under src/
       (Wad, Map, Sim). These must never reference Godot. The settings every
       project shares (framework, language, nullable, warnings as errors,
       analyzers) come from the repository root's Directory.Build.props. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <!-- Godot's export configurations reach these projects when the Godot
       project is built on its own (not via IsoDoom.sln). -->
  <PropertyGroup Condition="'$(Configuration)' == 'ExportRelease'">
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>
